{
  "format": 1,
  "version": "1.0.0",
  "kind": "mcp",
  "publisher": "Kaliper",
  "id": "zapier",
  "service": {
    "url": "https://mcp.zapier.com/api/v1/connect",
    "timeout_seconds": 60
  },
  "needs_router": "0.5.0",
  "display": {
    "name": "Zapier MCP",
    "summary": "Reads configured app data through the customer’s Zapier MCP server, a third-party integration gateway.",
    "categories": [
      "Productivity"
    ],
    "logo": {
      "letter": "Z",
      "color": "#FFFFFF",
      "image": "data:image/png;base64,"
    },
    "examples": [
      "Find the latest customer record in my connected CRM.",
      "What read actions are configured on my Zapier server?",
      "Search the app connections available to this server."
    ]
  },
  "connection": {
    "method": "form",
    "provider": "Zapier",
    "send": {
      "bearer": "ZAPIER_CONNECTION_TOKEN"
    },
    "fields": [
      {
        "key": "ZAPIER_CONNECTION_TOKEN",
        "label": "Zapier MCP connection token",
        "type": "password",
        "required": true,
        "help": "Generate in Zapier MCP Settings. This token can run all server tools; paste only the token here, never a token-bearing URL."
      }
    ],
    "guide": {
      "title": "Connect Zapier MCP",
      "summary": "Create a Zapier MCP server and enter its long-lived connection token. Rytangle exposes only the reviewed read tools.",
      "time": "About 10 minutes",
      "needs": [
        "A Zapier account with approved app connections.",
        "Permission to create and manage a Zapier MCP server."
      ],
      "access": "Kaliper exposes only reviewed read tools, but this token can call every tool the Zapier server offers, including writes outside Kaliper. Keep it encrypted on this server and out of Slack.",
      "steps": [
        {
          "title": "Create a Zapier MCP server",
          "text": "Open Zapier MCP, click **Add MCP server**, and choose **Other** as your AI agent.",
          "link": {
            "label": "Open vendor instructions",
            "url": "https://docs.zapier.com/mcp/get-started/connect/other"
          }
        },
        {
          "title": "Review connected apps",
          "text": "Check the connected apps and enabled actions. Remove any app connection the Slack workspace should not read.",
          "link": {
            "label": "Open vendor instructions",
            "url": "https://docs.zapier.com/mcp/overview/how-tools-work"
          }
        },
        {
          "title": "Generate a token",
          "text": "In the server’s **Settings** tab, click **Generate token**. Copy **Token**, not the token-bearing Connection URL.",
          "link": {
            "label": "Open vendor instructions",
            "url": "https://docs.zapier.com/mcp/get-started/connect/other"
          }
        },
        {
          "title": "Enter the token in Rytangle",
          "text": "Paste the token into **Zapier MCP connection token** on Rytangle’s web catalog page. Do not paste it into Slack."
        },
        {
          "title": "Test and enable",
          "text": "Click **Test connection**. Confirm a harmless read action works and no write-execution tool is offered, then choose **Save and turn on**."
        }
      ],
      "trouble": [],
      "source": {
        "label": "Zapier MCP custom-client setup",
        "url": "https://docs.zapier.com/mcp/get-started/connect/other"
      }
    }
  },
  "router": {
    "source": "zapier",
    "source_config": {},
    "agent": {
      "name": "zapier",
      "source": "zapier",
      "tools": [
        "inspect_zapier_actions",
        "discover_zapier_actions",
        "list_zapier_connections",
        "execute_zapier_read_action"
      ],
      "description": "Inspects and runs read actions from app connections on this customer’s Zapier MCP server.",
      "owns": "You own read-only actions on the customer’s Zapier MCP server. Never enable actions, execute write actions, change connections or create workflows.",
      "holds_documents": false,
      "first_for": "Connected Zapier app data and read actions"
    },
    "tool_descriptions": {
      "inspect_zapier_actions": "List enabled Zapier actions and their required inputs.",
      "discover_zapier_actions": "Search Zapier apps and available action definitions without enabling them.",
      "list_zapier_connections": "List app connections available on this Zapier MCP server.",
      "execute_zapier_read_action": "Run one permitted read or search action from an enabled Zapier app connection."
    }
  }
}
